import { Navigate, useLocation } from 'react-router-dom';
import useAuthStore from '@/stores/authStore';
import { useEffect } from 'react';

const ClientProtectedRoute = ({ children }) => {
  const {
    isAuthenticated,
    isLoading,
    authChecked,
    user,
    checkAuth,
  } = useAuthStore();

  const location = useLocation();

  useEffect(() => {
    if (!authChecked) {
      checkAuth();
    }
  }, [authChecked, checkAuth]);

  // NEVER redirect while the initial authentication check is still running.
  if (!authChecked || isLoading) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-[#F8FAFC] dark:bg-[#09090B]">
        <div className="text-center space-y-4">
          <div className="w-16 h-16 border-4 border-[#4F46E5] border-t-transparent rounded-full animate-spin mx-auto" />
          <p className="text-[#64748B] dark:text-[#A1A1AA] font-medium">
            Loading...
          </p>
        </div>
      </div>
    );
  }

  // Authentication has now been conclusively checked.
  if (!isAuthenticated) {
    return (
      <Navigate
        to="/client-portal/login"
        state={{ from: location }}
        replace
      />
    );
  }

  // Only clients may access the Client Portal.
  if (user?.role !== 'client') {
    return <Navigate to="/dashboard" replace />;
  }

  return children;
};

export default ClientProtectedRoute;
